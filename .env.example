# AGAM Technologies HRMS - Environment Configuration

# Backend (Core HRMS Rails API)
VITE_API_BASE_URL=/api/v1
# Dev server proxy target for /api/v1
VITE_API_PROXY_TARGET=http://localhost:3000

# Zoho OneAuth sign-in is disabled by default. Set to true (and ZOHO_LOGIN_ENABLED=true on the backend) to show it.
VITE_ENABLE_ZOHO_LOGIN=false
# Public client id only; the secret lives on the backend as ZOHO_CLIENT_SECRET
VITE_ZOHO_CLIENT_ID=
VITE_ZOHO_AUTH_URL=https://accounts.zoho.in/oauth/v2/auth
VITE_ZOHO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_ZOHO_SCOPE=AaaServer.profile.READ,email,profile
